{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://polish-learning/dictionary/manifest.schema.json",
  "title": "DictionaryManifest",
  "type": "object",
  "required": ["version", "generatedAt", "bundles", "checksum"],
  "properties": {
    "version": { "type": "string" },
    "generatedAt": { "type": "string" },
    "bundles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "sha256", "count", "language"],
        "properties": {
          "file": { "type": "string" },
          "sha256": { "type": "string" },
          "count": { "type": "integer" },
          "language": { "type": "string" }
        }
      }
    },
    "sqlite": {
      "type": "object",
      "properties": { "file": { "type": "string" }, "sha256": { "type": "string" } }
    },
    "checksum": { "type": "string" },
    "remap": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "sinceVersion"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "reason": { "type": "string" },
          "sinceVersion": { "type": "string" }
        }
      }
    }
  }
}
